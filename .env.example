# ============================================================================
# DATABASE
# ============================================================================
DATABASE_URL="postgresql://user:password@localhost:5432/erp_field_sales"

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# ============================================================================
# MEDIA STORAGE (AWS S3 or Cloudinary)
# ============================================================================
NEXT_PUBLIC_S3_BUCKET="your-s3-bucket"
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="eu-west-1"

# Alternative: Cloudinary
CLOUDINARY_NAME="your-cloudinary-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# ============================================================================
# EXTERNAL INTEGRATIONS
# ============================================================================
# Kargo Takibi (Shipment Tracking)
CARGO_TRACKER_API_URL="https://api.cargotracker.com"
CARGO_TRACKER_API_KEY="your-cargo-api-key"

# ============================================================================
# APP CONFIGURATION
# ============================================================================
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="ERP Field Sales System"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"